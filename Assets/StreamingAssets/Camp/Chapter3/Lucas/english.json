{
  "dialogueEntries": [
    {
      "name": "MainCharacter",
      "lines": [
        {
          "emotion": "idle",
          "line": "Hey Lucas, are you busy?"
        },
        {
          "emotion": "idle",
          "line": "You fought with a lot of courage back there."
        }
      ]
    },
    {
      "name": "Lucas",
      "lines": [
        {
          "emotion": "idle",
          "line": "Thanks."
        },
        {
          "emotion": "idle",
          "line": "..."
        }
      ]
    },
    {
      "name": "MainCharacter",
      "lines": [
        {
          "emotion": "idle",
          "line": "..."
        },
        {
          "emotion": "idle",
          "line": "Look, I know you don't know me, and we're going to be traveling together now."
        },
        {
          "emotion": "idle",
          "line": "But I promise I will do everything I can to keep you and your sister safe."
        }
      ]
    },
    {
      "name": "Lucas",
      "lines": [
        {
          "emotion": "idle",
          "line": "I appreciate it, but we won't be staying long."
        },
        {
          "emotion": "idle",
          "line": "Once we talk to Lord Beesly and get this straightened out, we're going back home."
        }
      ]
    },
    {
      "name": "MainCharacter",
      "lines": [
        {
          "emotion": "idle",
          "line": "I understand."
        },
        {
          "emotion": "idle",
          "line": "I just want you to know that you don't have to fight alone."
        },
        {
          "emotion": "idle",
          "line": "I know what it's like to care deeply for someone."
        },
        {
          "emotion": "idle",
          "line": "... and to lose someone you love."
        }
      ]
    },
    {
      "name": "Lucas",
      "lines": [
        {
          "emotion": "idle",
          "line": "..."
        },
        {
          "emotion": "idle",
          "line": "Did you need anything else?"
        }
      ]
    }
  ]
}