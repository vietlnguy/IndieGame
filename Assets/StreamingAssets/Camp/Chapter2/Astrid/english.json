{
  "dialogueEntries": [
    {
      "name": "Astrid",
      "lines": [
        {
          "emotion": "idle",
          "line": "Even though we had to leave our home, it's nice to be out in the countryside again."
        },
        {
          "emotion": "idle",
          "line": "I wonder how long we'll be gone."
        },
        {
          "emotion": "idle",
          "line": "Ooo when we get to Maplemire do you think we can get turkey pies??"
        },
        {
          "emotion": "idle",
          "line": "It's been so long since I've had one."
        },
        {
          "emotion": "idle",
          "line": "No, we shouldn't we should stay focused..."
        }
      ]
    },
    {
      "name": "MainCharacter",
      "lines": [
        {
          "emotion": "idle",
          "line": "*laughs*"
        }
      ]
    },
    {
      "name": "Astrid",
      "lines": [
        {
          "emotion": "idle",
          "line": "What's so funny??"
        }
      ]
    },
    {
      "name": "MainCharacter",
      "lines": [
        {
          "emotion": "idle",
          "line": "You, you're very cute."
        },
        {
          "emotion": "idle",
          "line": "We can get turkey pies, dear. I think it would do us some good to take our mind off of everything that's happened."
        },
        {
          "emotion": "idle",
          "line": "I miss this life sometimes."
        },
        {
          "emotion": "idle",
          "line": "Travelling the king's road, sword by my side, no plan. Just living life."
        }
      ]
    },
    {
      "name": "Astrid",
      "lines": [
        {
          "emotion": "idle",
          "line": "*coyly* You mean the life before you met me?"
        }
      ]
    },
    {
      "name": "MainCharacter",
      "lines": [
        {
          "emotion": "idle",
          "line": "Of course not!"
        },
        {
          "emotion": "idle",
          "line": "I would much rather live in the forest in isolation shoveling dirt and breaking my back."
        },
        {
          "emotion": "idle",
          "line": "...rather than spend my time at the tavern, drinking good ale, and knee deep in pus--"
        }
      ]
    },
    {
      "name": "Astrid",
      "lines": [
        {
          "emotion": "idle",
          "line": "*bonk*"
        },
        {
          "emotion": "idle",
          "line": "Oh hush, you."
        }
      ]
    },
    {
      "name": "MainCharacter",
      "lines": [
        {
          "emotion": "idle",
          "line": "*chuckles*"
        }
      ]
    },
    {
      "name": "Astrid",
      "lines": [
        {
          "emotion": "idle",
          "line": "Is there anything else you need, dear?"
        }
      ]
    }
  ]
}