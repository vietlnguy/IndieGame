{
    "dialogueEntries": [
        {
            "name": "MainCharacter",
            "lines" : [
                 {
                    "emotion": "idle",
                    "line": "Honey, I'm back!"
                 }
            ]

        },
        {
            "name": "Katherine",
            "lines" : [
                {
                    "emotion": "idle",
                    "line": "<rainb>Oh! Back so soon?</rainb>"
                },
                {
                    "emotion": "idle",
                    "line": "I've hardly started dinner!"
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines" : [
                {
                    "emotion": "idle",
                    "line": "I had an early start this morning."
                },
                {
                    "emotion": "idle",
                    "line": "Need an extra hand?"
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion" : "idle",
                    "line": "No thank you, dear."
                },
                {
                    "emotion" : "idle",
                    "line": "You've already done so much around the farm, I can handle dinner."
                },
                {
                    "emotion" : "idle",
                    "line": "You should relax!"
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion" : "idle",
                    "line": "It's hard to relax when there is still so much to do..."
                },
                {
                    "emotion" : "idle",
                    "line":"I'm the one that said we should move out here."
                },
                {
                    "emotion" : "idle",
                    "line":"I'm starting to wonder if that was a dumb decision..."
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "I've never regretted a second being here."
                },
                {
                    "emotion": "idle",
                    "line": "It doesn't matter where we are, as long as we're together, I'm happy."
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "I don't deserve you."
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                { 
                    "emotion": "idle",
                    "line": "Hehe, that's what they all say."
                },
                { 
                    "emotion": "idle",
                    "line": "Now why don't I help you relax a little more?"
                },
                { 
                    "emotion": "idle",
                    "line": "You must be so tense. Let me give you a hand."
                }

            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "Actually, I don't feel as sore as-- uughh--"
                }

            ],
            "pauseExecution": true
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "seductive",
                    "line": "Hehe, maybe you are just a dumb farmer."
                },
                {
                    "emotion": "seductive",
                    "line": "Working out in the sun all day must've turned your brain to mush."
                }


            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "Haah... maybe you're right.. Ahh..."
                },
                {
                    "emotion": "idle",
                    "line": "It doesn't help that you're draining all of the blood from my head now, too."
                }
            
            
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion":"idle",
                    "line": "It's okay, it's looks like it's going to a different head, hehe."
                },
                {
                    "emotion":"idle",
                    "line": "Looks like I better give it some special attention."

                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "Ungh..."
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "Mwgh, mwgh, mwgh..."
                }
            
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion":"idle",
                    "line": "Ahh-- it feels too good!"

                },
                {
                    "emotion":"idle",
                    "line": "I don't think I can hold it in any longer!"
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion":"idle",
                    "line": "Mmmmm--"
                }
            
            ],
            "pauseExecution": true
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion":"idle",
                    "line":"Hehe, feeling better?"
                }
            
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "I feel like a new man!"
                },
                {
                    "emotion": "idle",
                    "line": "Like I've got the strength to plow ten fields!"
                }

            
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion":"idle",
                    "line":"As long as you make time to plow mine."
                }
            
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "Of course!"
                },
                {
                    "emotion": "idle",
                    "line": "Truth be told... I was worried about moving to the countryside."

                },
                {
                    "emotion": "idle",
                    "line": "Away from all of our friends and family, starting over."
                },
                {
                    "emotion": "idle",
                    "line": "With all of that news about ancient Tah'Lo artifacts, the world seems to be spinning faster and faster."
                },
                {
                    "emotion": "idle",
                    "line": "A quiet life with you is all I need."
                }

            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "I couldn't agree more."

                },
                {
                    "emotion": "idle",
                    "line": "I am curious, though. They say the ancient Tah'Lo people were incredibly advanced."

                },
                {
                    "emotion": "idle",
                    "line": "I wonder what kind of amazing things they could do..."
                }
            
            
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "Beats me."
                },
                {
                    "emotion": "idle",
                    "line": "As long as it doesn't involve me, they can have all of the artifacts they want."
                }
            
            ],
            "pauseExecution": true
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion" : "idle",
                     "line": "Huh? Someone's at the door?"
                },
                {
                    "emotion" : "idle",
                    "line": "All the way out here?"
                }

            ],
            "pauseExecution": true
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "Hello. Apologies for the intrusion."
                },
                {
                    "emotion": "idle",
                    "line": "My name is Hegseth. I am a member of the Kings council."
                },
                {
                    "emotion": "idle",
                    "line": "What a wonderful home you have."
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Thank you."
                },
                {
                    "emotion": "idle",
                    "line":"Is there something I can help you with?"
                }

            
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "Yes, indeed."
                },
                {
                    "emotion": "idle",
                    "line": "As I am sure you are aware, our great King Reiss (long may he reign), has declared that all Tah'Lo artifacts be relinquished to local authorities."

                },
                {
                    "emotion": "idle",
                    "line": "It is for the safety and prosperity of the people that our king has decreed it."
                }
            

            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "That's fine, but we don't have any Tah'Lo artifacts."

                },
                {
                    "emotion": "idle",
                    "line": "I couldn't even tell you if I saw one."

                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line": "I see."
                },
                {
                    "emotion": "idle",
                    "line": "Well then, you wouldn't mind if we inspected the area?"
                },
                {
                    "emotion": "idle",
                    "line": "It is typical for Tah'Lo artifacts to go unnoticed by ...commoners."
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Is that necessary? There is nothing here but wheat and pig crap."
                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"I assure you it will not take long."
                },
                {
                    "emotion": "idle",
                    "line":"We would hate to send word to the king that some folk have been uncooperative..."
                }
        
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"..."
                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Good."

                },
                {
                    "emotion": "idle",
                    "line":"Now then..."

                },
                {
                    "emotion": "idle",
                    "line":"Men!"

                }
            ],
            "pauseExecution": true
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Yes, sir!"

                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Search the area for any Tah'Lo artifacts."

                },
                {
                    "emotion": "idle",
                    "line":"Be thorough, I will not tolerate any mistakes."

                }
            ]
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Yes, sir!"

                }
            ],
            "pauseExecution": true
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Did you find anything?"

                }
            ]
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Nothing, sir. Checked every nook and cranny."

                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Hmm. Perhaps you are telling the truth."

                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Now if you're done, I'd like you to leave. I have work to do."

                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Of course, of course!"
                },
                {
                    "emotion": "idle",
                    "line":"There's just one last thing..."
                },
                {
                    "emotion": "idle",
                    "line":"The lady's bracelets."
                },
                {
                    "emotion": "idle",
                    "line":"Hand them over."

                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"What? My bracelets?"

                },
                {
                    "emotion": "idle",
                    "line":"These aren't Tah'Lo artifacts. These are just ordinary bracelets."

                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"That will be for the king to decide."
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"What? No!"

                },
                {
                    "emotion": "idle",
                    "line":"There must be a mistake."

                },
                {
                    "emotion": "idle",
                    "line":"These were a gift from my mother! I can't give them away!"
                }

            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Such a shame.. But your mother will be proud of you for being a devout citizen of the kingdom."
                },
                {
                    "emotion": "idle",
                    "line":"Now let me take those off your hands--"
                }
            ],
            "pauseExecution": true
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Stop right there. That's enough."
                },
                {
                    "emotion": "idle",
                    "line":"We told you we don't have any relics."
                },
                {
                    "emotion": "idle",
                    "line":"I am going to have to ask you and the men you brought to leave."
                }
            ],
            "pauseExecution": true
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"I would think very carefully about what you are doing, boy."
                },
                {
                    "emotion": "idle",
                    "line":"To defy me, is to defy your king."
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"I won't ask you again."
                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Very well. You leave me no choice then."
                },
                {
                    "emotion": "idle",
                    "line":"Soldier! Grab the woman and take the bracelet! Kill them both if you have to."
                }
            ]
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Yes, sir!"

                }
            ],
            "pauseExecution": true
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Ah- "
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Katherine!!!"
                }
            ],
            "pauseExecution": true
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"What the--"
                }
            ]
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Ack!"
                }
            ],
            "pauseExecution": true
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Oof--"
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"What the..."
                },
                {
                    "emotion": "idle",
                    "line":"Katherine, what's happening?"
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"I don't know. I just felt a surge of power coming from my bracelets!"
                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"What are you doing, soldier?? Kill her!"
                }
            ]
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Uh..."
                },
                {
                    "emotion": "idle",
                    "line":"Yes, sir!"
                }
            ],
            "pauseExecution": true
        },
        {
            "name": "Soldier",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Urgh..."
                }
            ]
        },
        {
            "name": "Hegseth",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Useless..."

                },
                {
                    "emotion": "idle",
                    "line":"Retreat! We'll regroup outside and take the relic by force!"
                }

            ],
            "pauseExecution": true
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Argh. That doesn't sound good."
                },
                {
                    "emotion": "idle",
                    "line":"Katherine, are you okay?"
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"*huff huff*"
                },
                {
                    "emotion": "idle",
                    "line":"Yes, I'm okay."
                },
                {
                    "emotion": "idle",
                    "line":"I just need to catch my breath then I'll be ready to fight."
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"No, you should stay here. I can handle this."
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"No way."
                },
                {
                    "emotion": "idle",
                    "line":"I am just as much a fighter as you."
                },
                {
                    "emotion": "idle",
                    "line":"We will protect our home together."
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Ug, fine. But stay close, I can't stand the thought of loosing you."
                },
                {
                    "emotion": "idle",
                    "line":"Let's go."

                }
            ],
            "pauseExecution": true
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"It's been a while since we've been in battle."
                },
                {
                    "emotion": "idle",
                    "line":"Let's take this slowly."

                },
                {
                    "emotion": "idle",
                    "line":"I'll face the enemy, you support me from behind."
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Got it!"
                }
            ],
            "pauseExecution": true
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Phew... I don't know the last time I swung a sword."
                },
                {
                    "emotion": "idle",
                    "line":"Or killed a man.."
                },
                {
                    "emotion": "idle",
                    "line":"It's done now, we're safe."
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"..."
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"What's wrong? Are you okay?"
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"What are we going to do now? We can't stay here."
                },
                {
                    "emotion": "idle",
                    "line":"As long as I have these bracelets, we'll never be safe."
                },
                {
                    "emotion": "idle",
                    "line":"Maybe I should've just handed them over."
                }
            ]
        },
        {
            "name": "MainCharacter",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"Absolutely not."
                },
                {
                    "emotion": "idle",
                    "line":"We're going to speak with Lord Beesly, in town. I've known him to be an honorable man."
                },
                {
                    "emotion": "idle",
                    "line":"He will speak to the royal envoy and fix this."
                }
            ]
        },
        {
            "name": "Katherine",
            "lines": [
                {
                    "emotion": "idle",
                    "line":"*sigh* And just as we were getting settled in..."
                }
            ]
        }
    ]
}